*.pgd

# 可执行文件（无后缀或常见后缀）
*.exe
*.out
*.app
*.bin

# 调试 / 覆盖率信息
*.gcno
*.gcda
*.gcov

# CMake 构建目录（常见）
build/
cmake-build-*/
CMakeCache.txt
CMakeFiles/
Makefile
cmake_install.cmake
install_manifest.txt

# CUDA 专用
*.ptx
*.cubin
*.fatbin
*.cu.o
*.cu.ptx
*.cu.cubin
*.cu.fatbin

# 编译器生成的临时文件
*.d
*.dep

# 测试 / 性能分析产物
*.prof
*.gcda
*.gcno

